NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME
SESSION_SECRET=replace-with-a-random-value-at-least-32-bytes-long

# Optional connection-pool tuning; default is 8, valid range is 1-50.
# DB_POOL_MAX=8

# Required for email-code sign-in and delivery.
# AUTH_CODE_PEPPER=replace-with-a-different-random-value-at-least-32-bytes-long
# RESEND_API_KEY=
# EMAIL_FROM=RouteNest <sign-in@example.com>

# Set these only for a split Static Site + Web Service deployment.
# FRONTEND_URL=https://your-frontend.onrender.com
# API_BASE_URL=https://your-backend.onrender.com

# Optional authentication settings (defaults are documented in docs/render-deployment.md).
# SESSION_MAX_AGE_SECONDS=604800
# AUTH_CODE_TTL_SECONDS=600
# AUTH_CODE_MAX_ATTEMPTS=5
# AUTH_RATE_LIMIT_WINDOW_SECONDS=900
# AUTH_REQUEST_LIMIT_PER_EMAIL=3
# AUTH_REQUEST_LIMIT_PER_IP=30
# AUTH_VERIFY_LIMIT_PER_EMAIL=10
# AUTH_VERIFY_LIMIT_PER_IP=60
# TRUST_PROXY_HOPS=1

# Configure temporarily for the initial Super Admin claim, then remove.
# PLATFORM_BOOTSTRAP_KEY=

# Configure only when Razorpay billing is enabled.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
